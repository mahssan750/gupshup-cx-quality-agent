# Never commit the real key. Create a restricted OpenRouter key with a hard USD limit.
OPENROUTER_API_KEY=
CXQUALITY_DB=local/cxquality.sqlite3
CXQUALITY_BUDGET_USD=4.00
CXQUALITY_STOP_AT_USD=3.80
CXQUALITY_DECISION_MODEL=typesafe/jev-1.14
CXQUALITY_WRITER_MODEL=openai/gpt-6-luna
CXQUALITY_AI_WORKERS=6
CXQUALITY_ROSTER=C:\path\to\agents.xlsx
CXQUALITY_ROSTER_OVERRIDES=local/agent-overrides.json

# Versioned bilingual evaluator (jev, llm, hybrid)
CXQUALITY_EVALUATION_MODE=hybrid
CXQUALITY_REVIEWER_MODEL=openai/gpt-6.1-sol
# Conservative preflight estimates; actual provider cost is recorded.
CXQUALITY_REVIEWER_INPUT_PER_MILLION=10
CXQUALITY_REVIEWER_OUTPUT_PER_MILLION=40
